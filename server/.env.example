# Server-only configuration. Never expose this file to Vite.
# Copy to server/.env and fill secrets in your secret store, not in git.

NODE_ENV=development
PORT=3001
HOST=127.0.0.1
LOG_LEVEL=info
TRUST_PROXY=false

# privy: verify real email login tokens. mock: local development only.
# NODE_ENV=production refuses AUTH_MODE=mock.
AUTH_MODE=privy

# PostgreSQL. For a local demo without PostgreSQL you may use the embedded
# PostgreSQL build with DATABASE_URL=pglite:memory (data is lost on restart).
DATABASE_URL=postgres_connection_string

PRIVY_APP_ID=matching_app_id
PRIVY_APP_SECRET=set_in_server_secret_store
# Optional. Paste the app's JWT verification key to avoid fetching JWKS.
PRIVY_JWT_VERIFICATION_KEY=

CHAIN_ID=11155111
RPC_URL=server_rpc
GLOWPET_ADDRESS=verified_sepolia_contract
ALLOWED_SERIES_IDS=1
DEPLOY_BLOCK=0

# The relayer is a dedicated, low-balance, non-owner Sepolia account.
# It must not be reused for anything else. Never commit the private key.
RELAYER_ENABLED=false
RELAYER_PRIVATE_KEY=set_in_server_secret_store
CLAIM_CONFIRMATIONS=2
CLAIM_AUTH_MAX_TTL_SECONDS=600
# All three limits are mandatory before any sponsored broadcast is enabled.
# Set values measured from actual claim estimates; there are no infinite defaults.
RELAYER_MAX_GAS_PER_TX=250000
RELAYER_MAX_FEE_PER_GAS_WEI=5000000000
RELAYER_DAILY_BUDGET_WEI=100000000000000000

# Browser origins allowed to call the API directly. Keep the dev proxy origins
# here; remove unused origins in production.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Per-account limits. The IP limit is enforced by the API process.
CLAIM_RATE_LIMIT_PER_MINUTE=10
CLAIM_RATE_LIMIT_PER_HOUR=60
