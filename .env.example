# Everything in this file is PUBLIC: Vite bundles VITE_* values into the
# browser build. Never put a private key, seed phrase or API secret here.

# Address of the deployed Glowpet contract (not the art contracts).
VITE_GLOWPET_ADDRESS=0xYourDeployedGlowpetAddress

# Series opened by default. The app reads seriesInfo(seriesId) from the contract.
VITE_GLOWPET_SERIES_ID=1

# Block in which Glowpet was deployed. Used by "Find my Glowpet on-chain".
# Leave 0 if your RPC allows scanning from genesis.
VITE_DEPLOY_BLOCK=0

# Read-only Sepolia RPC. Replace it if the public endpoint is blocked.
VITE_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Demo only: per-charm proof files generated with `npm run serials:demo`.
# The Vite dev server serves them from .glowpet-demo/proofs; they are never
# included in a production build. Real charms carry this credential in their
# NFC tag / QR code instead. Set an empty value to disable "Load proof".
VITE_PROOF_BASE_URL=/proofs

# Account and sponsored-claim mode.
# off   - guest/read-only plus the existing external-wallet flow
# privy - email one-time-code login and a platform-sponsored claim
# mock  - local development only; `vite build` rejects it
VITE_AUTH_MODE=off

# Public Privy app ID. Required when VITE_AUTH_MODE=privy.
# The server uses its own PRIVY_APP_ID/PRIVY_APP_SECRET in server/.env.
VITE_PRIVY_APP_ID=

# Same-origin API path. The dev server proxies /api to http://127.0.0.1:3001.
VITE_API_BASE_URL=/api/v1
